{
  "name": "opencode-sessions-sidebar",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Extensible sessions sidebar for OpenCode — core and V1 adapter development libraries",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aalvarez-dev/opencode-sessions-sidebar.git"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "check": "bun run format:check && bun run typecheck && bun run typecheck:core && bun run check:boundaries && bun run test && bun run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "check:boundaries": "bun run scripts/check-boundaries.ts",
    "test": "bun test",
    "build": "bun run scripts/build.ts && tsc -p tsconfig.build.json",
    "benchmark:v1": "bun run scripts/benchmark-v1.ts",
    "benchmark:v1:runtime": "bun run scripts/benchmark-v1-runtime.ts",
    "smoke:v1": "bun run scripts/smoke-v1.ts",
    "smoke:v1:attention": "bun run scripts/smoke-v1-attention.ts"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.30",
    "@opencode-ai/sdk": "1.18.30",
    "@types/bun": "1.3.14",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/opencode-v1": {
      "types": "./dist/adapters/opencode-v1/index.d.ts",
      "import": "./dist/adapters/opencode-v1/index.js"
    }
  }
}
